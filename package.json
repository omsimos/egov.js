{
  "name": "egov.js",
  "version": "0.1.0",
  "description": "OpenAPI specification and generated TypeScript SDK for Philippine eGov APIs.",
  "keywords": [
    "api",
    "egov",
    "egovph",
    "government",
    "openapi",
    "philippines",
    "sdk",
    "typescript"
  ],
  "homepage": "https://github.com/omsimos/egov.js#readme",
  "bugs": {
    "url": "https://github.com/omsimos/egov.js/issues"
  },
  "license": "MIT",
  "author": "Omsimos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omsimos/egov.js.git"
  },
  "files": [
    "dist",
    "openapi.json",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./openapi.json": {
      "default": "./openapi.json"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "generate": "openapi-ts && node scripts/fix-generated.mjs && oxfmt src/generated/sdk.gen.ts src/generated/client/utils.gen.ts",
    "check:generated": "node scripts/check-generated.mjs",
    "openapi:lint": "redocly lint openapi.json --extends=spec",
    "dev": "tsdown --watch",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test scripts openapi-ts.config.ts tsdown.config.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "audit": "pnpm audit --audit-level high",
    "check:package": "publint && attw --pack . --profile node16",
    "docs:dev": "pnpm --dir docs dev",
    "docs:build": "pnpm --dir docs build",
    "check": "pnpm format:check && pnpm lint && pnpm openapi:lint && pnpm check:generated && pnpm typecheck && pnpm test && pnpm build && pnpm check:package && pnpm docs:build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm check && changeset publish",
    "prepack": "pnpm generate && pnpm build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "2.31.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@redocly/cli": "2.46.0",
    "@types/node": "26.2.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "publint": "0.3.23",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.33.0"
}
